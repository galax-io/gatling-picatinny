# Keep the Docker build context small: leave out version control data, build output and tool caches,
# IDE files, run output and local tool settings.
# A pattern without `**/` matches at the root of the context only.

# Version control
.git/

# Build output and build tool caches
**/target/
**/build/
**/.gradle/
**/.bloop/
**/.metals/
.bsp/
**/metals.sbt
project/project/

# IDE and editor files
.idea/
.vscode/
.settings/
.classpath
.project
**/*.iml

# Local run output
report/
results/
**/*.log

# Local tool settings, which may hold machine-specific data
.claude/settings.local.json
**/.mcp.json
